{
  "name": "signyu",
  "version": "0.3.0",
  "description": "Official Node.js SDK for the SignYu Aadhaar eSign API",
  "keywords": [
    "aadhaar",
    "esign",
    "aadhaar-esign",
    "e-signature",
    "digital-signature",
    "india",
    "emudhra",
    "signyu"
  ],
  "homepage": "https://signyu.com/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signyu/signyu-node.git"
  },
  "bugs": {
    "url": "https://github.com/signyu/signyu-node/issues",
    "email": "contact@mail.signyu.com"
  },
  "author": "SignYu <contact@mail.signyu.com> (https://signyu.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/client.test.mjs test/webhooks.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
